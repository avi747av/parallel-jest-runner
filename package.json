{
  "name": "parallel-jest-runner",
  "version": "0.0.0",
  "description": "Run Jest tests in parallel shards for faster execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "parallel-jest-runner": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish"
  },
  "keywords": [
    "jest",
    "testing",
    "parallel",
    "coverage",
    "sharding",
    "performance"
  ],
  "author": "Avi747av",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "peerDependencies": {
    "jest": ">=26.0.0",
    "nyc": ">=15.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.17.46",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
